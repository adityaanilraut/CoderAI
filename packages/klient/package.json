{
  "name": "@coderai/klient",
  "version": "0.1.3",
  "private": true,
  "description": "Kimi client SDK \u2014 contract-driven facade over agent-core-v2, with an in-memory transport.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./memory": {
      "types": "./src/transports/memory/index.ts",
      "default": "./src/transports/memory/index.ts"
    },
    "./package.json": {
      "types": "./package.json",
      "default": "./package.json"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@coderai/agent-core-v2": "workspace:^",
    "zod": "4.3.6"
  }
}
