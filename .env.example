# CoderAI Environment Configuration
# Variables set here override ~/.coderai/settings.json and ./.coderai/settings.json

# Model and Provider Settings
CODERAI_MODEL=gpt-5.6-luna
CODERAI_BASE_URL=https://api.openai.com/v1
CODERAI_API_KEY=

# Optional LLM Parameters
CODERAI_TEMPERATURE=
CODERAI_THINKING_ENABLED=
CODERAI_REASONING_EFFORT=max
CODERAI_DEBUG_LOG_ENABLED=false
CODERAI_TOOLS_PRESET=core
