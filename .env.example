# CoderAI configuration (env overrides ~/.coderai/settings.json and ./.coderai/settings.json).
# See docs/REDESIGN.md for the settings model.

# Provider
CODERAI_MODEL=gpt-4o
CODERAI_BASE_URL=https://api.openai.com/v1
CODERAI_API_KEY=

# Optional
CODERAI_TEMPERATURE=
CODERAI_THINKING_ENABLED=
CODERAI_DEBUG_LOG_ENABLED=
