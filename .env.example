# CoderAI Environment Configuration
# Variables set here override ~/.coderai/settings.json and ./.coderai/settings.json

# Model and Provider Settings
# (commented out so copying this file to .env does not silently override
# settings.json or setup-wizard choices — env wins over files)
# CODERAI_MODEL=gpt-6-luna
# CODERAI_BASE_URL=https://api.openai.com/v1
# CODERAI_API_KEY=

# Provider API keys (or configure via `/setup keys` — saved to ~/.coderai/settings.json)
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=  # get one at https://openrouter.ai/keys; unlocks dynamic :free models in /model
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional LLM Parameters
# CODERAI_TEMPERATURE=
# CODERAI_THINKING_ENABLED=
# CODERAI_REASONING_EFFORT=max
# CODERAI_DEBUG_LOG_ENABLED=false
# CODERAI_TOOLS_PRESET=core

# Model tuning (defaults live in settings.json; env wins over files)
# CODERAI_MODEL_TEMPERATURE=
# CODERAI_MODEL_TOP_P=
# CODERAI_MODEL_MAX_TOKENS=
# CODERAI_MODEL_MAX_COMPLETION_TOKENS=
# CODERAI_MODEL_THINKING_KEEP=

# Orchestration knobs (env wins over settings.json orchestration block)
# CODERAI_MAX_STEPS_PER_TURN=
# CODERAI_MAX_RETRIES_PER_STEP=
# CODERAI_MAX_RALPH_ITERATIONS=  # 0 = off, -1 = unlimited
# CODERAI_MAX_SUBAGENT_DEPTH=  # default 3
# CODERAI_SUBAGENT_TIMEOUT_SECONDS=  # default 90
# CODERAI_MAX_PARALLEL_TOOL_CALLS=  # default 10
# CODERAI_MAX_CONTINUABLE_AGENTS_PER_SESSION=  # default 50
# CODERAI_MAX_RUNNING_JOBS_PER_SESSION=  # default 50

# JEV System-One triage gate for /review (needs coderai-agent[jev])
# CODERAI_JEV_TIMEOUT_S=
# CODERAI_JEV_MAX_WORKERS=
# CODERAI_JEV_MAX_CLIENTS=
# CODERAI_JEV_CACHE_SIZE=
# CODERAI_JEV_MAX_DIFF_CHARS=
# CODERAI_JEV_ACCEPT_THRESHOLD=
# CODERAI_JEV_GATE_THRESHOLD=
# CODERAI_JEV_TRIAGE_THRESHOLD=
# CODERAI_JEV_SPECULATIVE_THRESHOLD=
# CODERAI_JEV_MIN_CONFIDENCE=
# CODERAI_JEV_STATUS_TTL_S=

# Accessibility
# CODERAI_ACCESSIBLE=

# Web retrieval (see docs/web-tools.md). No key is required for the http provider.
# EXA_API_KEY=
# PERPLEXITY_API_KEY=
# CODERAI_WEB_SEARCH_PROVIDER=http
# CODERAI_WEB_SEARCH_TOOL=/absolute/path/to/search-script
# DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
